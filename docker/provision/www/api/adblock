#!/usr/bin/lua
-- /api/adblock — GET (Task 1) + POST (Task 3). Real dnsmasq-blocklist-backed
-- status/toggle for the Ad Blocking screen. Reads/writes the baseline
-- config created by docker/provision/09-provision-adblock-api.sh (see that
-- script and docker/facts.md Section 12 for the confirmed live
-- investigation this endpoint is built on).
--
-- GET response shape: {"enabled": true|false, "blockedThisWeek": <int>}
--
-- === enabled ===
-- `uci get dhcp.@dnsmasq[0].confdir` currently equals the exact path the
-- blocklist was provisioned at (/etc/dnsmasq.blocklist.d) -> true. Absent,
-- unreadable, or pointed somewhere else -> false. This deliberately checks
-- the *current* live value rather than a fixed boolean, so a config that's
-- been hand-reverted or repointed elsewhere over SSH is correctly reported
-- as disabled without needing this endpoint to change.
--
-- === blockedThisWeek ===
-- Real count of `logread` lines matching the pattern `config <domain> is
-- 0.0.0.0`, for each of the three domains the blocklist was provisioned
-- with (doubleclick.net, adservice.google.com, tracker.example.com —
-- confirmed live in docker/facts.md Section 12 to be dnsmasq's exact,
-- distinct log signature for a blocked hit, thanks to
-- dhcp.@dnsmasq[0].logqueries=1 being set by the provisioning script). This
-- is a genuinely different signature from `config error is REFUSED`, which
-- is what shows for literally every *other* lookup on this VM (there is no
-- WAN here — see docker/facts.md — so nothing ever resolves successfully
-- upstream; "blocked vs. not queried/not in our list" is the only
-- meaningful comparison this environment can make, not "blocked vs.
-- successfully resolved").
--
-- Data source: `logread` via io.popen, same shell-out approach as
-- `system-info`'s `ubus call` and `logs`' `logread -l 30`. Unlike `logs`
-- (which caps at 30 lines for a short "recent activity" UI list), this
-- endpoint intentionally does NOT pass `-l N` — it wants to count every
-- blocked-hit line currently in the log buffer, not just the newest 30
-- overall lines (which would mostly be non-blocklist noise like dropbear
-- session lines and drown out the count).
--
-- *** "This week" is aspirational, not literal — documented limitation ***
-- `logread`'s buffer is a small, fixed-size in-memory ring (nowhere near a
-- full week's worth of DNS query history), so this genuinely counts
-- everything currently sitting in that buffer, not a true rolling 7-day
-- count. That's an accepted limitation for this dev/test environment, not
-- something this endpoint tries to paper over with fake persistence — a
-- real "per-week" counter would need a separate on-disk counter/database
-- that survives log rotation and VM restarts, which is out of scope here.
-- The number is real (every count reflects an actual blocked DNS lookup
-- that really happened), just not a guaranteed *complete* week of them.
--
-- Line-matching approach: each of the three domains is a fixed, known
-- constant this endpoint controls (not client input), and the log line
-- signature is a literal substring, not a pattern with capture groups to
-- extract — so this uses plain literal substring search
-- (`string.find(line, needle, 1, true)`, the `true` "plain" flag disabling
-- Lua pattern-magic-character interpretation) rather than a `string.match`
-- pattern like `logs`/`system-info` use for their own field extraction.
-- This is simpler and correct here specifically because there is nothing to
-- capture — a `find`-based containment check is all "did this log line
-- represent a blocked hit for domain X" needs.
--
-- JSON encoding: hand-built, same choice as every other endpoint in this
-- directory (no outbound internet route on this VM to opkg-install
-- lua-cjson — see docker/provision/www/api/devices's header comment). This
-- endpoint's response has no free-form string fields (just a bool and an
-- int), so no escaper is needed for the response itself.
--
-- Graceful degradation: if `uci get` or `logread` fails for any reason,
-- `enabled` falls back to false and `blockedThisWeek` falls back to 0
-- (io.popen returning nil, or the command producing no matching output,
-- both degrade to "nothing counted" rather than crashing or emitting
-- malformed JSON) — same discipline as `wifi`'s GET handler.
--
-- === POST (Task 3) — real enable/disable toggle ===
--
-- POST body: {"enabled": true|false} — writes dhcp.@dnsmasq[0].confdir
-- accordingly and reports the new state.
--
-- Both directions confirmed live against this running VM before writing
-- this handler (not just assumed symmetric):
--   enabled:true  -> `uci set dhcp.@dnsmasq[0].confdir=/etc/dnsmasq.blocklist.d`
--                     (also re-asserts logqueries=1, in case it was ever
--                     hand-cleared — cheap insurance, this option has no
--                     effect on whether blocking itself works, only on
--                     whether blockedThisWeek can count anything).
--   enabled:false -> `uci delete dhcp.@dnsmasq[0].confdir` — confirmed live
--                     over SSH that this genuinely stops blocking, not just
--                     that `uci get` afterward returns "Entry not found":
--                     after delete+commit+`/etc/init.d/dnsmasq restart`, a
--                     real `nslookup doubleclick.net 127.0.0.1` returns
--                     REFUSED — indistinguishable from a real `nslookup
--                     example.com 127.0.0.1` control lookup against a
--                     never-blocklisted domain on this WAN-less VM (see
--                     docker/facts.md: every lookup here is REFUSED
--                     upstream regardless, since there's no WAN — REFUSED is
--                     exactly what a *not-blocked* lookup looks like in this
--                     environment, not an error). `uci set confdir=...`
--                     afterward, re-tested, brought the 0.0.0.0 result right
--                     back. This is NOT a case of "unset must obviously mean
--                     off" being assumed — it was verified end-to-end.
--
-- Body parsing: same hand-rolled json_parse_flat_object + literal-string
-- validation approach as `wifi`'s parse_guest_enabled() (adapted verbatim,
-- see that file's header comment for the full rationale) — no lua-cjson on
-- this VM (no outbound internet route to opkg-install it). The parser
-- returns a bare JSON `true`/`false` token as the Lua *string* "true"/
-- "false" (not a real Lua boolean), and a JSON string `"true"` parses
-- identically — those two input shapes are indistinguishable after parsing,
-- which is fine here: valid input is defined as "the parsed value is
-- exactly the string 'true' or the string 'false'", anything else (missing
-- key, "1"/"0", a number, "yes", empty string, null, etc.) is rejected as
-- 400.
--
-- Write sequence: uci set/delete -> readback verify -> uci commit ->
-- dnsmasq restart. If the readback doesn't match what was requested, the
-- write is rolled back (`uci revert dhcp`) and never committed, and the
-- endpoint responds 500 rather than falsely claiming success — same
-- verify-before-commit/revert-on-failure discipline as `wifi`/
-- `firewall-rules`' POST handlers. `/etc/init.d/dnsmasq restart` after a
-- successful commit is what makes the change live (matches
-- 09-provision-adblock-api.sh's own baseline-creation sequence).
--
-- Invalid/missing input is rejected with 400 and touches no config at all
-- (no `uci` write command runs before the validation check). Unsupported
-- methods (anything but GET/POST) get 405.

local EXPECTED_CONFDIR = "/etc/dnsmasq.blocklist.d"
local BLOCKED_DOMAINS = { "doubleclick.net", "adservice.google.com", "tracker.example.com" }

local function run(cmd)
  local p = io.popen(cmd .. " 2>/dev/null")
  if not p then return "" end
  local out = p:read("*a") or ""
  p:close()
  return (out:gsub("%s+$", ""))
end

local function uci_get(path)
  local out = run("uci get " .. path)
  -- Same "uci: ..." error-text-on-stdout defense as docker/provision/www/api/wifi's
  -- uci_get() — anchored at the START of output only, so a legitimate value
  -- that merely contains "uci:" somewhere is never false-flagged.
  if out == "" or out:match("^uci:") then return nil end
  return out
end

local function is_enabled()
  local confdir = uci_get("dhcp.@dnsmasq[0].confdir")
  return confdir == EXPECTED_CONFDIR
end

local function count_blocked_this_week()
  -- Deliberately no `-l N` cap here (unlike `logs`' `logread -l 30`) — see
  -- header comment: this wants every blocked-hit line currently in the log
  -- buffer, not just the newest N overall lines.
  local raw = run("logread")
  local count = 0
  for line in raw:gmatch("[^\r\n]+") do
    for _, domain in ipairs(BLOCKED_DOMAINS) do
      if line:find("config " .. domain .. " is 0.0.0.0", 1, true) then
        count = count + 1
        break -- a line can only match one domain; don't double-count it
      end
    end
  end
  return count
end

-- Wrap a value for safe use as a single shell argument. Adapted verbatim
-- from `wifi`/`firewall-rules`' shell_quote(). This endpoint's only
-- writable value is a constant path string it derives itself (never raw
-- client input placed directly into a shell command), but every
-- interpolated value still goes through this per the established
-- convention, for consistency and defense-in-depth.
local function shell_quote(s)
  s = tostring(s or "")
  s = s:gsub('[\1-\9\11-\31]', '') -- strip control chars
  s = s:gsub('[\n\r]', ' ')
  return "'" .. s:gsub("'", "'\\''") .. "'"
end

local function read_request_body()
  local len = tonumber(os.getenv("CONTENT_LENGTH") or "")
  if len and len > 0 then
    return io.read(len) or ""
  end
  -- No/invalid Content-Length: read whatever is available, defensively.
  return io.read("*a") or ""
end

-- === Narrow, defensive flat-JSON-object parser ===
-- Adapted verbatim from `wifi`/`firewall-rules`' json_parse_flat_object
-- (see `wifi`'s header comment for the full rationale): understands
-- `{"key":"string value","key2":123}` — quoted-string values (with escapes)
-- and bare numeric/true/false/null tokens — and nothing else.
local function json_parse_flat_object(s)
  local obj = {}
  if type(s) ~= "string" then return obj end
  local i, len = 1, #s

  local function skip_ws()
    while i <= len and s:sub(i, i):match("%s") do i = i + 1 end
  end

  local function parse_string()
    i = i + 1 -- opening quote
    local buf = {}
    local escapes = {
      ['"'] = '"', ['\\'] = '\\', ['/'] = '/',
      ['n'] = '\n', ['r'] = '\r', ['t'] = '\t', ['b'] = '\b', ['f'] = '\f',
    }
    while i <= len do
      local c = s:sub(i, i)
      if c == '"' then
        i = i + 1
        return table.concat(buf)
      elseif c == '\\' then
        local nc = s:sub(i + 1, i + 1)
        if nc == 'u' then
          i = i + 6 -- skip \uXXXX — not needed for this endpoint's fields
        elseif escapes[nc] then
          buf[#buf + 1] = escapes[nc]
          i = i + 2
        else
          buf[#buf + 1] = nc
          i = i + 2
        end
      else
        buf[#buf + 1] = c
        i = i + 1
      end
    end
    return table.concat(buf) -- unterminated string: return what we got
  end

  skip_ws()
  if s:sub(i, i) ~= '{' then return obj end
  i = i + 1
  skip_ws()
  if s:sub(i, i) == '}' then return obj end

  while i <= len do
    skip_ws()
    if s:sub(i, i) ~= '"' then break end
    local key = parse_string()
    skip_ws()
    if s:sub(i, i) ~= ':' then break end
    i = i + 1
    skip_ws()
    local val
    if s:sub(i, i) == '"' then
      val = parse_string()
    else
      local start = i
      while i <= len and not s:sub(i, i):match('[,}%s]') do i = i + 1 end
      val = s:sub(start, i - 1)
    end
    obj[key] = val
    skip_ws()
    if s:sub(i, i) == ',' then
      i = i + 1
    elseif s:sub(i, i) == '}' then
      i = i + 1
      break
    else
      break
    end
  end
  return obj
end

-- Parses the POST body's `enabled` field into a real Lua boolean, or
-- returns nil for anything invalid/missing/ambiguous. Same "accept exactly
-- the strings 'true'/'false'" contract as `wifi`'s parse_guest_enabled() —
-- see this file's header comment on why a genuine JSON boolean and the
-- JSON strings "true"/"false" are indistinguishable after parsing here, and
-- why that's an acceptable, well-defined input contract.
local function parse_enabled(body)
  local req = json_parse_flat_object(body)
  local v = req.enabled
  if v == "true" then return true end
  if v == "false" then return false end
  return nil
end

-- Emits response headers. uhttpd (running this as CGI) reads a
-- `Status: <code> <reason>` header line, printed before the blank separator
-- alongside Content-Type, to set the HTTP status of the response; omitting
-- it defaults to 200, so the success path intentionally emits no Status
-- line. Mirrors `wifi`/`firewall-rules`' send_headers() exactly.
local function send_headers(status)
  local reasons = {
    [400] = "Bad Request",
    [405] = "Method Not Allowed",
    [500] = "Internal Server Error",
  }
  if status and status ~= 200 then
    print("Status: " .. status .. " " .. (reasons[status] or "Error"))
  end
  print("Content-Type: application/json\n")
end

-- === Request handling ===

local method = os.getenv("REQUEST_METHOD") or "GET"

if method == "GET" then
  send_headers(200)
  print(string.format(
    '{"enabled":%s,"blockedThisWeek":%d}',
    is_enabled() and "true" or "false",
    count_blocked_this_week()
  ))

elseif method == "POST" then
  local body = read_request_body()
  local enabled_req = parse_enabled(body)

  if enabled_req == nil then
    -- Invalid/missing input: reject with 400 and do NOT touch config at all
    -- (nothing above this point has issued any `uci` write command).
    send_headers(400)
    print('{"ok":false,"error":"missing or invalid required field: enabled (must be a JSON boolean true or false)"}')
  else
    if enabled_req then
      run("uci set dhcp.@dnsmasq[0].confdir=" .. shell_quote(EXPECTED_CONFDIR))
      -- Re-assert logqueries=1 every time enabling, in case it was ever
      -- hand-cleared over SSH — cheap insurance, doesn't affect whether
      -- blocking itself works, only whether blockedThisWeek can count
      -- anything (see header comment).
      run("uci set dhcp.@dnsmasq[0].logqueries=1")
    else
      -- Confirmed live (see header comment): deleting confdir genuinely
      -- stops blocking, not just removes the uci option.
      run("uci delete dhcp.@dnsmasq[0].confdir")
    end

    -- Verify the write actually took effect via readback BEFORE committing
    -- — same discipline as `wifi`/`firewall-rules`' POST handlers. On the
    -- enable path this checks BOTH writes issued above (confdir AND
    -- logqueries) — not just confdir — since GET's blockedThisWeek count
    -- depends entirely on logqueries genuinely being '1' (otherwise
    -- `logread` has no matching lines to count, silently stranding the
    -- count at 0 even though confdir looks correct and blocking itself
    -- works). Either field failing its readback fails the whole write, via
    -- the same single `readback_ok` check and revert+500 path below — not
    -- two separate failure paths. uci_get() returns nil on a
    -- failed/empty/absent lookup, which is exactly the expected readback
    -- for the disable path (logqueries isn't touched there at all — see
    -- header comment).
    local readback_confdir = uci_get("dhcp.@dnsmasq[0].confdir")
    local readback_ok
    if enabled_req then
      local readback_logqueries = uci_get("dhcp.@dnsmasq[0].logqueries")
      readback_ok = (readback_confdir == EXPECTED_CONFDIR) and (readback_logqueries == "1")
    else
      readback_ok = (readback_confdir == nil)
    end

    if not readback_ok then
      run("uci revert dhcp")
      send_headers(500)
      print('{"ok":false,"error":"failed to verify dhcp.@dnsmasq[0].confdir/logqueries write; reverted"}')
    else
      run("uci commit dhcp")
      -- Makes the change live — same sequence 09-provision-adblock-api.sh
      -- uses for the baseline config, and confirmed live for the disable
      -- direction too (see header comment).
      run("/etc/init.d/dnsmasq restart")
      send_headers(200)
      print(string.format('{"ok":true,"enabled":%s}', enabled_req and "true" or "false"))
    end
  end

else
  -- REQUEST_METHOD is server-set, but defensively strip anything that could
  -- break the JSON string literal (this endpoint has no json_escape() of
  -- its own, unlike wifi/firewall-rules, since every other field it ever
  -- emits is a fixed literal) rather than assume it's always a clean token.
  local safe_method = tostring(method):gsub('[\\"%c]', '')
  send_headers(405)
  print(string.format('{"ok":false,"error":"unsupported method: %s"}', safe_method))
end
