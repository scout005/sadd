#!/usr/bin/lua
-- /api/firewall-rules — real GET/POST/DELETE against this VM's own UCI
-- firewall config, backed by fw4/nftables (not a simulated/in-memory list).
--
-- === Topology investigation (Task 7) — why `src` is hardcoded to 'wan' ===
--
-- `docker/facts.md` Section 3 already established this VM has **no
-- `network.wan` interface at all** — confirmed still true, re-checked live
-- against this running VM before writing this file (`uci show network`).
-- `uci show firewall` (also re-checked live, matches facts.md Section 4
-- exactly) still ships a `wan` *zone* (`firewall.@zone[1].name='wan'`,
-- `.network='wan' 'wan6'`) even though neither of those networks exists —
-- this is normal stock OpenWrt config and is not itself an error.
--
-- What this means for a `config redirect` (port-forward) with `src='wan'`,
-- confirmed live by hand before writing any code (add a throwaway redirect
-- over SSH, `fw4 reload`, inspect `nft list ruleset`): fw4 *does* generate
-- a real, correctly-matching DNAT rule for it — but places it in a
-- `dstnat_wan` chain that the top-level `dstnat` chain never jumps into,
-- because that jump is keyed on `iifname "br-lan"` (the one real network
-- device that exists) and there is no equivalent device/iifname for the
-- (non-existent) wan network. Concretely, a real `src='wan'` redirect's
-- generated rule looks exactly like this (captured live):
--
--   chain dstnat_wan {
--     meta nfproto ipv4 tcp dport 9999 counter dnat 192.168.1.232:8080 comment "!fw4: TestWanFwd"
--   }
--
-- ...and nothing in the ruleset ever jumps to `dstnat_wan` — so this rule
-- is real, correctly-generated, and semantically exactly what a genuine
-- WAN port-forward should produce, but it is unreachable by any packet in
-- this specific VM's topology (there is no WAN-facing path for a packet to
-- arrive on in the first place). This was confirmed by direct
-- observation, not assumed.
--
-- Despite that, this endpoint still hardcodes `src='wan'` (not `src='lan'`)
-- for rules it creates, because:
--   1. The POST body shape given to this endpoint (`{name, proto,
--      src_dport, dest_ip, dest_port}`) has no `src` field at all — the
--      caller (Task 8's "Firewall & Ports" UI) is modeling classic
--      external->internal port-forwarding (the Xbox/NVR use case), which
--      is only a real, meaningful concept with `src='wan'`. A `src='lan'`
--      rule is a same-subnet hairpin redirect, a different feature.
--   2. If a later wave gives this VM a real WAN interface, every rule this
--      endpoint has ever created becomes correctly live with zero config
--      changes — the config already says exactly what it should.
--   3. `dest='lan'` and `target='DNAT'` are set explicitly (rather than
--      left to fw4's defaults) purely to avoid fw4's informational
--      "assuming 'lan'" stderr warning observed during investigation when
--      `dest` was left unset — cosmetic, `dest` already defaults to 'lan'.
--
-- Given all that, a literal "curl the forwarded external port from this
-- repo's normal shell and see it reach the internal target" test (the
-- plan's original wording) is **not possible** against this endpoint's
-- real `src='wan'` rules in this environment — there is no WAN-facing
-- address for that traffic to arrive on. What this endpoint's shipped
-- verification actually does instead (see docker/README.md's Provisioning
-- section and docker/facts.md's Task 7 addendum for the full write-up):
--   (a) confirms the exact `nft list ruleset` dstnat_wan rule generated by
--       a real POST matches the intended match criteria (proto/port/
--       dest_ip/dest_port) — a real proof that this endpoint's uci
--       add/set/rename/commit + reload pipeline produces correct,
--       semantically-real firewall config, not just a plausible-looking
--       API response; and
--   (b) separately, over SSH (not through this endpoint, and not part of
--       this endpoint's shipped behavior), proves the underlying
--       mechanism this endpoint relies on — a `config redirect` UCI
--       section reloaded via `/etc/init.d/firewall reload` really does
--       make fw4/nftables intercept and redirect a real, live TCP
--       connection — by creating a manual `src='lan'` redirect (the one
--       zone in this topology with a real reachable device, `br-lan`) and
--       driving actual traffic through it end to end (a throwaway
--       container on the `openwrt` container's own netns connecting to
--       `192.168.1.1:<forwarded-port>`, landing on a real `nc` listener
--       bound to a separately DHCP-leased address on the same segment).
--       That test is not shipped as part of this endpoint (this endpoint
--       always uses `src='wan'`, per the reasoning above) — it exists
--       purely to validate that the reload/enforcement mechanism itself is
--       real, which is the part of "is this actually real, not just
--       displayed" that *is* testable in this topology.
--
-- === UCI addressing ===
--
-- `docker/facts.md` Section 4 confirms this VM's stock firewall config has
-- zero `config redirect` sections and recommends explicitly renaming each
-- newly-added anonymous section to a stable name right after `uci add`,
-- since anonymous sections are addressed by a positional index
-- (`firewall.@redirect[N]`) that shifts when another redirect is deleted.
-- This endpoint follows that recommendation: POST generates an id shaped
-- `fwd_<unix-time>_<6 hex chars from /dev/urandom>` and immediately runs
-- `uci rename firewall.<anon-id>=<that-id>`, then addresses the section by
-- that stable name for every subsequent `uci set`/`uci get`/`uci delete`
-- call (including from a later, unrelated DELETE request) — never by
-- positional index.
--
-- === JSON handling ===
--
-- Same reasoning as docker/provision/www/api/devices: no lua-cjson on this
-- VM (side-loading a third opkg package for a handful of flat-object
-- fields isn't worth it — see that file's header comment for the full
-- reasoning, which applies identically here). GET hand-builds JSON with
-- the same defensive json_escape() used there. POST needs to go the other
-- direction — parse a small, controlled JSON object from the request body
-- — so this file adds a narrow, defensive flat-object-only JSON parser
-- (json_parse_flat_object below): it understands `{"key":"string value",
-- "key2":123}` — quoted-string values (with `\"  \\ \n \r \t \b \f`
-- escapes, and `\uXXXX` sequences skipped rather than decoded, since none
-- of this endpoint's fields need unicode escapes) and bare numeric/
-- true/false/null tokens — and nothing else (no nesting, no arrays). That
-- is the entire shape Task 8's frontend ever needs to send.

local function json_escape(s)
  if s == nil then return "" end
  s = tostring(s)
  s = s:gsub('[\\"\n\r\t]', {
    ['\\'] = '\\\\',
    ['"'] = '\\"',
    ['\n'] = '\\n',
    ['\r'] = '\\r',
    ['\t'] = '\\t',
  })
  s = s:gsub('[\1-\31]', '')
  return s
end

-- Wrap a value for safe use as a single shell argument (single-quoted,
-- with embedded single quotes escaped the standard POSIX way). Every
-- value that reaches a `uci`/`fw4` shell command by way of this endpoint
-- (POST body fields, the DELETE id) goes through this — the id is also
-- separately restricted to a fixed safe character set below, but values
-- like `name`/`dest_ip` are free-form request input and are not otherwise
-- trusted.
local function shell_quote(s)
  s = tostring(s or "")
  s = s:gsub('[\1-\9\11-\31]', '') -- strip control chars (keep \n=10 out too via the general set below)
  s = s:gsub('[\n\r]', ' ')
  return "'" .. s:gsub("'", "'\\''") .. "'"
end

local function run(cmd)
  local p = io.popen(cmd .. " 2>&1")
  if not p then return "" end
  local out = p:read("*a") or ""
  p:close()
  return out
end

-- === Narrow, defensive flat-JSON-object parser (see header comment) ===
local function json_parse_flat_object(s)
  local obj = {}
  if type(s) ~= "string" then return obj end
  local i, len = 1, #s

  local function skip_ws()
    while i <= len and s:sub(i, i):match("%s") do i = i + 1 end
  end

  local function parse_string()
    i = i + 1 -- opening quote
    local buf = {}
    local escapes = {
      ['"'] = '"', ['\\'] = '\\', ['/'] = '/',
      ['n'] = '\n', ['r'] = '\r', ['t'] = '\t', ['b'] = '\b', ['f'] = '\f',
    }
    while i <= len do
      local c = s:sub(i, i)
      if c == '"' then
        i = i + 1
        return table.concat(buf)
      elseif c == '\\' then
        local nc = s:sub(i + 1, i + 1)
        if nc == 'u' then
          i = i + 6 -- skip \uXXXX — not needed for this endpoint's fields
        elseif escapes[nc] then
          buf[#buf + 1] = escapes[nc]
          i = i + 2
        else
          buf[#buf + 1] = nc
          i = i + 2
        end
      else
        buf[#buf + 1] = c
        i = i + 1
      end
    end
    return table.concat(buf) -- unterminated string: return what we got
  end

  skip_ws()
  if s:sub(i, i) ~= '{' then return obj end
  i = i + 1
  skip_ws()
  if s:sub(i, i) == '}' then return obj end

  while i <= len do
    skip_ws()
    if s:sub(i, i) ~= '"' then break end
    local key = parse_string()
    skip_ws()
    if s:sub(i, i) ~= ':' then break end
    i = i + 1
    skip_ws()
    local val
    if s:sub(i, i) == '"' then
      val = parse_string()
    else
      local start = i
      while i <= len and not s:sub(i, i):match('[,}%s]') do i = i + 1 end
      val = s:sub(start, i - 1)
    end
    obj[key] = val
    skip_ws()
    if s:sub(i, i) == ',' then
      i = i + 1
    elseif s:sub(i, i) == '}' then
      i = i + 1
      break
    else
      break
    end
  end
  return obj
end

local function url_decode(s)
  s = s:gsub('+', ' ')
  s = s:gsub('%%(%x%x)', function(h) return string.char(tonumber(h, 16)) end)
  return s
end

local function read_request_body()
  local len = tonumber(os.getenv("CONTENT_LENGTH") or "")
  if len and len > 0 then
    return io.read(len) or ""
  end
  -- No/invalid Content-Length: read whatever is available, defensively.
  return io.read("*a") or ""
end

-- === UCI firewall helpers ===

-- Parses `uci show firewall` into an ordered list of redirect-section ids
-- plus a table of their fields. Handles both stable-named sections
-- (`firewall.fwd_123=redirect`) and anonymous ones
-- (`firewall.@redirect[0]=redirect`, e.g. if something other than this
-- endpoint ever adds one by hand) — an id never contains a literal '.',
-- so splitting each field line on its FIRST '.' after "firewall." reliably
-- separates id from field name either way.
local function list_redirect_sections()
  local output = run("uci show firewall")
  local order = {}
  local is_redirect = {}
  local fields = {}
  for line in output:gmatch("[^\n]+") do
    local lhs, rhs = line:match("^(.-)=(.*)$")
    if lhs and rhs then
      local rest = lhs:match("^firewall%.(.+)$")
      if rest then
        local dot = rest:find("%.")
        if dot then
          local id = rest:sub(1, dot - 1)
          local field = rest:sub(dot + 1)
          if is_redirect[id] then
            local val = rhs:match("^'(.-)'$")
            if not val then val = rhs end
            fields[id][field] = val
          end
        else
          local id = rest
          local typ = rhs:match("^'?(.-)'?$")
          if typ == "redirect" and not is_redirect[id] then
            is_redirect[id] = true
            order[#order + 1] = id
            fields[id] = {}
          end
        end
      end
    end
  end
  return order, fields
end

-- `run()` already merges stderr into its captured output (see run()'s own
-- "2>&1"), so for a nonexistent id this just returns uci's "Entry not
-- found" error text rather than "redirect" — the equality check below
-- handles that correctly without needing a separate /dev/null redirect.
local function section_type(id)
  local out = run("uci get firewall." .. id)
  return (out:gsub("%s+$", ""))
end

local function random_hex(nbytes)
  local f = io.open("/dev/urandom", "rb")
  if not f then return tostring(os.time()) end
  local bytes = f:read(nbytes) or ""
  f:close()
  local hex = {}
  for k = 1, #bytes do
    hex[#hex + 1] = string.format("%02x", bytes:byte(k))
  end
  return table.concat(hex)
end

local function is_valid_port(v)
  if not v then return false end
  v = tostring(v):match("^%s*(.-)%s*$")
  if not v:match("^%d+$") then return false end
  local n = tonumber(v)
  return n and n >= 1 and n <= 65535, v
end

local function is_valid_ipv4(v)
  if not v then return false end
  local a, b, c, d = v:match("^(%d+)%.(%d+)%.(%d+)%.(%d+)$")
  if not a then return false end
  for _, octet in ipairs({ a, b, c, d }) do
    local n = tonumber(octet)
    if not n or n < 0 or n > 255 then return false end
  end
  return true
end

local function normalize_proto(v)
  if type(v) ~= "string" then return "tcp" end
  local lower = v:lower():match("^%s*(.-)%s*$")
  if lower == "tcp" or lower == "udp" then return lower end
  return "tcp"
end

local function reload_firewall()
  run("/etc/init.d/firewall reload")
end

-- Emits the response headers (and the blank-line separator print()'s
-- trailing "\n" plus the implicit newline already provides) for this
-- request. uhttpd (running this as CGI) reads a `Status: <code> <reason>`
-- header line, printed before the blank separator alongside Content-Type,
-- to set the HTTP status of the response; omitting it defaults to 200,
-- so the success path (status == 200) intentionally emits no Status line.
local function send_headers(status)
  local reasons = {
    [400] = "Bad Request",
    [404] = "Not Found",
    [405] = "Method Not Allowed",
    [500] = "Internal Server Error",
  }
  if status and status ~= 200 then
    print("Status: " .. status .. " " .. (reasons[status] or "Error"))
  end
  print("Content-Type: application/json\n")
end

-- === Request handling ===

local method = os.getenv("REQUEST_METHOD") or "GET"

if method == "GET" then
  send_headers(200)
  local order, fields = list_redirect_sections()
  local parts = {}
  for _, id in ipairs(order) do
    local f = fields[id]
    parts[#parts + 1] = string.format(
      '{"id":"%s","name":"%s","proto":"%s","src_dport":"%s","dest_ip":"%s","dest_port":"%s"}',
      json_escape(id),
      json_escape(f.name or ""),
      json_escape(f.proto or ""),
      json_escape(f.src_dport or ""),
      json_escape(f.dest_ip or ""),
      json_escape(f.dest_port or "")
    )
  end
  print("[" .. table.concat(parts, ",") .. "]")

elseif method == "POST" then
  local body = read_request_body()
  local req = json_parse_flat_object(body)

  local name = req.name
  if type(name) ~= "string" or name == "" then name = "Forward" end
  local proto = normalize_proto(req.proto)

  local dport_ok, src_dport = is_valid_port(req.src_dport)
  local destport_ok, dest_port = is_valid_port(req.dest_port)
  local ip_ok = is_valid_ipv4(req.dest_ip)

  if not dport_ok or not destport_ok or not ip_ok then
    local err = "Invalid or missing required field(s):"
    if not dport_ok then err = err .. " src_dport" end
    if not ip_ok then err = err .. " dest_ip" end
    if not destport_ok then err = err .. " dest_port" end
    send_headers(400)
    print(string.format('{"ok":false,"error":"%s"}', json_escape(err)))
  else
    -- Create sequence: uci add -> uci rename -> a run of uci set calls ->
    -- uci commit. Every step's actual effect is verified (not just that
    -- the `run()` call returned) before committing — see Issue 1's header
    -- note above `run()`'s own definition-adjacent commentary. On any
    -- failure, uncommitted changes are rolled back with `uci revert
    -- firewall` and nothing is committed, so a failed create never leaves
    -- a partial/broken `redirect` section live in the committed config.
    local id
    local create_failed = false
    local create_error = nil

    local anon = run("uci add firewall redirect"):gsub("%s+$", "")
    if anon == "" or anon:find("[^%w_]") then
      create_failed = true
      create_error = "uci add firewall redirect failed"
    else
      id = "fwd_" .. os.time() .. "_" .. random_hex(3)
      run("uci rename firewall." .. anon .. "=" .. id)
      -- Verify the rename actually took: the section must now exist
      -- under the new stable name and still be type 'redirect'. If
      -- `uci rename` silently failed, every subsequent `uci set
      -- firewall.<id>....` below would target a nonexistent section and
      -- silently no-op — this check catches that before it happens.
      if section_type(id) ~= "redirect" then
        create_failed = true
        create_error = "uci rename to " .. id .. " failed: section not found under new name"
      else
        run("uci set firewall." .. id .. ".name=" .. shell_quote(name))
        run("uci set firewall." .. id .. ".src=wan") -- see header comment
        run("uci set firewall." .. id .. ".dest=lan")
        run("uci set firewall." .. id .. ".target=DNAT")
        run("uci set firewall." .. id .. ".proto=" .. shell_quote(proto))
        run("uci set firewall." .. id .. ".src_dport=" .. shell_quote(src_dport))
        run("uci set firewall." .. id .. ".dest_ip=" .. shell_quote(req.dest_ip))
        run("uci set firewall." .. id .. ".dest_port=" .. shell_quote(dest_port))

        -- Final sanity check, before committing: read each field back
        -- and confirm it actually got set as expected.
        local function get_field(field)
          return (run("uci get firewall." .. id .. "." .. field):gsub("%s+$", ""))
        end
        if get_field("src") ~= "wan"
            or get_field("dest") ~= "lan"
            or get_field("target") ~= "DNAT"
            or get_field("proto") ~= proto
            or get_field("src_dport") ~= src_dport
            or get_field("dest_ip") ~= req.dest_ip
            or get_field("dest_port") ~= dest_port then
          create_failed = true
          create_error = "uci set verification failed for firewall." .. id
        end
      end
    end

    if create_failed then
      run("uci revert firewall")
      send_headers(500)
      print(string.format('{"ok":false,"error":"%s"}', json_escape(create_error)))
    else
      run("uci commit firewall")
      reload_firewall()
      send_headers(200)
      print(string.format('{"ok":true,"id":"%s","name":"%s"}', json_escape(id), json_escape(name)))
    end
  end

elseif method == "DELETE" then
  local path_info = os.getenv("PATH_INFO") or ""
  local id = path_info:match("^/?([^/]+)$")
  if not id or id == "" then
    local qs = os.getenv("QUERY_STRING") or ""
    local raw = qs:match("id=([^&]*)")
    if raw then id = url_decode(raw) end
  end

  if not id or id == "" or id:find("[^%w_]") then
    send_headers(400)
    print('{"ok":false,"error":"missing or invalid id"}')
  elseif section_type(id) ~= "redirect" then
    send_headers(404)
    print(string.format('{"ok":false,"error":"no such firewall-rule id: %s"}', json_escape(id)))
  else
    run("uci delete firewall." .. id)
    run("uci commit firewall")
    reload_firewall()
    send_headers(200)
    print(string.format('{"ok":true,"id":"%s"}', json_escape(id)))
  end

else
  send_headers(405)
  print(string.format('{"ok":false,"error":"unsupported method: %s"}', json_escape(method)))
end
